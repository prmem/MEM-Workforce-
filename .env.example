# Copy to .env.local and fill in. Never commit real values.
# For local development, `npm run db:start` prints the local values.

# Public (safe in the browser): Supabase project URL and anon / publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# SERVER ONLY. Never expose to the browser. Used only for admin invites and
# blocking sign-in of deactivated employees.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Public base URL of this app (used in invite / password-reset email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development / tests only: password given to fictional seed users.
# The seed script refuses to run against a non-local Supabase URL.
SEED_USER_PASSWORD=replace-with-a-local-dev-password
